terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}

# ---------- Network ----------

resource "google_compute_network" "k8s" {
  name                    = "k8s-network"
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "k8s" {
  name          = "k8s-subnet"
  network       = google_compute_network.k8s.id
  region        = var.region
  ip_cidr_range = "10.10.0.0/24" # matches the Kubespray inventory addressing
}

# Node-to-node: allow everything inside the subnet (simplest correct rule
# for Kubernetes: etcd, kubelet, VXLAN, BGP, NodePorts all covered)
resource "google_compute_firewall" "internal" {
  name    = "k8s-allow-internal"
  network = google_compute_network.k8s.name

  allow {
    protocol = "tcp"
  }
  allow {
    protocol = "udp"
  }
  allow {
    protocol = "icmp"
  }

  source_ranges = [
    google_compute_subnetwork.k8s.ip_cidr_range,
    "10.233.0.0/18",  # service CIDR
    "10.233.64.0/18", # pod CIDR
  ]
}

# External access: SSH for Ansible, 6443 for kubectl, 80/443 for ingress
resource "google_compute_firewall" "external" {
  name    = "k8s-allow-external"
  network = google_compute_network.k8s.name

  allow {
    protocol = "tcp"
    ports    = ["22", "6443", "80", "443"]
  }

  source_ranges = [var.ssh_allowed_cidr]
  target_tags   = ["k8s-node"]
}

# ---------- Instances ----------

data "google_compute_image" "ubuntu" {
  family  = "ubuntu-2404-lts-amd64"
  project = "ubuntu-os-cloud"
}

locals {
  all_nodes = merge(
    { for name, octet in var.control_plane_nodes : name => {
      octet        = octet
      machine_type = var.control_plane_machine_type
      role         = "control-plane"
    } },
    { for name, octet in var.worker_nodes : name => {
      octet        = octet
      machine_type = var.worker_machine_type
      role         = "worker"
    } },
  )
}

resource "google_compute_instance" "node" {
  for_each = local.all_nodes

  name         = each.key
  machine_type = each.value.machine_type
  zone         = var.zone
  tags         = ["k8s-node", each.value.role]

  boot_disk {
    initialize_params {
      image = data.google_compute_image.ubuntu.self_link
      size  = var.disk_size_gb
      type  = var.disk_type # SSD strongly recommended: etcd is fsync-latency sensitive
    }
  }

  network_interface {
    subnetwork = google_compute_subnetwork.k8s.id
    network_ip = "10.10.0.${each.value.octet}" # static internal IP = inventory IP

    access_config {
      # ephemeral external IP for SSH
    }
  }

  metadata = {
    ssh-keys = "${var.ssh_user}:${var.ssh_public_key}"
  }

  # required for Calico/pod routing
  can_ip_forward = true
}

# ---------- Auto-generate the Kubespray inventory ----------

resource "local_file" "inventory" {
  filename        = "${path.module}/../kubespray/inventory/mycluster/inventory.ini"
  file_permission = "0644"
  content         = <<-EOT
    # GENERATED BY TERRAFORM - do not edit by hand (re-run terraform apply instead)

    [kube_control_plane]
    %{for name, octet in var.control_plane_nodes~}
    ${name} ansible_host=${google_compute_instance.node[name].network_interface[0].access_config[0].nat_ip} ip=10.10.0.${octet} etcd_member_name=etcd${index(keys(var.control_plane_nodes), name) + 1}
    %{endfor~}

    [etcd:children]
    kube_control_plane

    [kube_node]
    %{for name, octet in var.worker_nodes~}
    ${name} ansible_host=${google_compute_instance.node[name].network_interface[0].access_config[0].nat_ip} ip=10.10.0.${octet}
    %{endfor~}

    [all:vars]
    ansible_user=${var.ssh_user}
    ansible_ssh_private_key_file=~/.ssh/k8s-deploy
    ansible_become=true
  EOT
}
